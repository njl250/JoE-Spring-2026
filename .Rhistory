state_column_name <- colnames(pre_solar)[2]
solar_wide_cumulative <- pre_solar %>%
# Select your state column and your specific target year columns
select(all_of(state_column_name), `Year 2010`, `Year 2011`, `Year 2012`) %>%
# Standardize your state column header name to "State"
rename(State = 1) %>%
# Calculate cumulative totals row-by-row across your year columns
# This automatically implements your rule by holding the previous year flat if a cell is 0
mutate(
`2010` = `Year 2010`,
`2011` = `2010` + `Year 2011`,
`2012` = `2011` + `Year 2012`
)
# 2. Extract state column and data columns dynamically based on your layout
# (Assumes column 2 contains the state names, and subsequent columns are your years)
state_column_name <- colnames(pre_solar)[2]
solar_wide_cumulative <- pre_solar %>%
# Select your state column and your specific target year columns
select(all_of(state_column_name), `Year 2010`, `Year 2011`, `Year 2012`) %>%
# Standardize your state column header name to "State"
rename(State = 1) %>%
# Calculate cumulative totals row-by-row across your year columns
