mutate(
Year_2010 = `Year 2010`,
Year_2011 = `Year 2010` + `Year 2011`,
Year_2012 = (`Year 2010` + `Year 2011`) + `Year 2012`
) %>%
# Print your updated wide matrix to verify the cell totals accumulated properly
print(head(solar_wide_cumulative, n = 16))
View(pre_solar)
# 2. Hardcode the exact selections so R cannot get confused
solar_wide_cumulative <- pre_solar %>%
# Select column 2 (your State column) and your exact updated headers using backticks
select(2, `Year 2010`, `Year 2011`, `Year 2012`) %>%
# Ensure the first column is named exactly "State"
rename(State = 1) %>%
# 3. Perform the math using backticks for the right side (where names have spaces)
# and unquoted names on the left side (to strip the quotes entirely)
mutate(
Year_2010 = `Year 2010`,
Year_2011 = `Year 2010` + `Year 2011`,
Year_2012 = (`Year 2010` + `Year 2011`) + `Year 2012`
) %>%
# 4. Keep ONLY your State and the clean, quote-free cumulative totals
select(State, Year_2010, Year_2011, Year_2012)
View(pre_solar)
# 2. Extract columns by their exact position number instead of text names
solar_wide_cumulative <- pre_solar %>%
# Select column 2 (State), column 3 (2010), column 4 (2011), and column 5 (2012)
select(State = 2, 3, 4, 5)
# 2. Extract columns by their exact position number instead of text names
solar_wide_cumulative <- pre_solar %>%
# Select column 2 (State), column 3 (2010), column 4 (2011), and column 5 (2012)
select(State = 1, 2, 3, 4)
# 3. Check what R actually named these columns so we can use them
col_names <- colnames(solar_wide_cumulative)
# 4. Perform the math using index tracking to prevent text crashes
solar_wide_cumulative <- solar_wide_cumulative %>%
mutate(
Year_2010 = .[[2]],                  # Pulls the data from the 2010 column position
Year_2011 = .[[2]] + .[[3]],         # Adds 2010 + 2011 column positions
Year_2012 = (.[[2]] + .[[3]]) + .[[4]] # Adds 2010 + 2011 + 2012 column positions
) %>%
# 5. Output only your State and the clean, quote-free cumulative totals
select(State, Year_2010, Year_2011, Year_2012)
