. * ------------------------------------------------------------------------------
. * HonestDiD helper: finds the pre- and post-period coefficients in a stored
. * event study and plots robust confidence intervals for the AVERAGE
. * post-treatment effect as parallel-trends violations grow (M = 0 to 2)
. * ------------------------------------------------------------------------------
. capture program drop hd_plot

. program define hd_plot
  1.     args est title file
  2.     estimates restore `est'
  3.     local names : colnames e(b)
  4.     local pre ""
  5.     local post ""
  6.     local i = 0
  7.     foreach n of local names {
  8.         local ++i
  9.         if substr("`n'", 1, 2) == "Tm" & "`n'" != "Tm1" local pre  "`pre' `i'"
 10.         if substr("`n'", 1, 2) == "Tp" local post "`post' `i'"
 11.     }
 12.     local pre_first  : word 1 of `pre'
 13.     local pre_last   : word `: word count `pre'' of `pre'
 14.     local post_first : word 1 of `post'
 15.     local post_last  : word `: word count `post'' of `post'
 16.     local npost : word count `post'
 17.     matrix lvec = J(1, `npost', 1 / `npost')
 18. 
.     honestdid, pre(`pre_first'/`pre_last') post(`post_first'/`post_last') ///
>         l_vec(lvec) mvec(0(0.25)2) delta(rm) coefplot ///
>         title("`title'") xtitle("M (Relative Magnitude of Violation)") ///
>         ytitle("95% Robust CI, Average Post-Treatment Effect")
 19.     graph export "`file'", replace width(2000)
 20. end

