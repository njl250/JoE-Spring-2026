. * ============================================================================
> ==
. * PART 2: CALLAWAY & SANT'ANNA + HONESTDID
. * ============================================================================
> ==
. 
. * --- Mata helper: breakdown value M-bar from the HonestDiD confidence sets.
. *     M-bar = largest M at which the robust 95% CI still excludes zero.
. *     Returns -1 if the CI already includes zero at M = 0.
. capture mata: mata drop mbar_calc()

. mata:
------------------------------------------------- mata (type end to exit) ------
: real scalar mbar_calc(real matrix CI, real scalar sgn)
> {
>     real scalar j, mcol, i, lo, hi, best, k
>     real colvector others
>     // The M column is the one with a missing value (the "Original" row)
>     mcol = 0
>     for (j = 1; j <= cols(CI); j++) {
>         if (missing(CI[., j]) > 0) mcol = j
>     }
>     if (mcol == 0) mcol = 1
>     best = -1
>     for (i = 1; i <= rows(CI); i++) {
>         if (missing(CI[i, mcol])) continue
>         others = J(0, 1, .)
>         for (k = 1; k <= cols(CI); k++) {
>             if (k != mcol) others = others \ CI[i, k]
>         }
>         lo = min(others)
>         hi = max(others)
>         if ((sgn > 0 & lo > 0) | (sgn < 0 & hi < 0)) {
>             if (CI[i, mcol] > best) best = CI[i, mcol]
>         }
>         else break
>     }
>     return(best)
> }

: end
--------------------------------------------------------------------------------

. 
. * --- Results file
. capture postclose csres

. tempfile csresults

. postfile csres str10 outcome double n_treated att se pval post_avg ///
>     pre_chi2 pre_df pre_p mbar using "`csresults'", replace
(file C:\Users\LOCAL_~1\Temp\ST_366c_000001.tmp not found)

. 
. * --- One Callaway & Sant'Anna run: ATT, event study, pre-trend test, HonestDi
> D
. capture program drop run_cs

. program define run_cs
  1.     args y g stub label
  2. 
.     display _newline as result "==============================================
> ===="
  3.     display as result "Callaway & Sant'Anna: `label'"
  4.     display as result "=================================================="
  5. 
.     quietly levelsof state_id if `g' > 0, local(tr)
  6.     local ntr : word count `tr'
  7. 
.     csdid `y' ln_gdp_pc is_rps, ivar(state_id) time(year) gvar(`g') ///
>         notyet long2 method(dripw)
  8.     estimates store cs_`stub'
  9. 
.     * Overall ATT
.     estat simple, post
 10.     local att = _b[ATT]
 11.     local se  = _se[ATT]
 12.     local pv  = 2 * normal(-abs(`att' / `se'))
 13. 
.     * Event study, full window -> plot
.     estimates restore cs_`stub'
 14.     estat event
 15.     csdid_plot, title("Green Bonds Allocated to `label'") ///
>         ytitle("Effect on ln(`label' W per Person + 1)") ///
>         xtitle("Years Relative to Treatment")
 16.     graph export "$DESKTOP/cs_event_`stub'.png", replace width(2000)
 17. 
.     * Event study used for the pre-trend test and HonestDiD.
.     * Leads limited to t = -6 to -2: longer leads rest on only one or two stat
> es.
.     estimates restore cs_`stub'
 18.     estat event, window(-5 8) estore(ev_`stub')
 19.     estimates restore ev_`stub'
 20.     local post_avg = _b[Post_avg]
 21. 
.     local names : colnames e(b)
 22.     local leads ""
 23.     local pre ""
 24.     local post ""
 25.     local i = 0
 26.     foreach n of local names {
 27.         local ++i
 28.         if substr("`n'", 1, 2) == "Tm" & "`n'" != "Tm1" {
 29.             local leads "`leads' `n'"
 30.             local pre "`pre' `i'"
 31.         }
 32.         if substr("`n'", 1, 2) == "Tp" local post "`post' `i'"
 33.     }
 34. 
.     * Pre-trend test: joint Wald test that all leads equal zero
.     test `leads'
 35.     local chi = r(chi2)
 36.     local df  = r(df)
 37.     local pp  = r(p)
 38. 
.     * HonestDiD (relative magnitudes) for the average post-treatment effect
.     local pre_first  : word 1 of `pre'
 39.     local pre_last   : word `: word count `pre'' of `pre'
 40.     local post_first : word 1 of `post'
 41.     local post_last  : word `: word count `post'' of `post'
 42.     local npost : word count `post'
 43.     matrix lvec = J(1, `npost', 1 / `npost')
 44. 
.     * Plot (M = 0 to 2 in steps of 0.25)
.     honestdid, pre(`pre_first'/`pre_last') post(`post_first'/`post_last') ///
>         l_vec(lvec) mvec(0(0.25)2) delta(rm) coefplot ///
>         title("HonestDiD Sensitivity: `label'") ///
>         xtitle("M (Relative Magnitude of Violation)") ///
>         ytitle("95% Robust CI, Average Post-Treatment Effect")
 45.     graph export "$DESKTOP/cs_honestdid_`stub'.png", replace width(2000)
 46. 
.     * Breakdown value M-bar on a finer grid (steps of 0.05)
.     local mbar = .
 47.     capture noisily {
 48.         honestdid, pre(`pre_first'/`pre_last') post(`post_first'/`post_last
> ') ///
>             l_vec(lvec) mvec(0(0.05)2) delta(rm)
 49.         local hes `s(HonestEventStudy)'
 50.         mata: st_local("mbar", strofreal(mbar_calc(`hes'.CI, `post_avg')))
 51.     }
 52.     if missing(`mbar') {
 53.         display as error "M-bar could not be read from honestdid; use the t
> able above."
 54.     }
 55.     else if `mbar' < 0 {
 56.         display as result "M-bar (`label'): CI includes zero even at M = 0"
 57.     }
 58.     else {
 59.         display as result "M-bar (`label') = `mbar'"
 60.     }
 61. 
.     post csres ("`label'") (`ntr') (`att') (`se') (`pv') (`post_avg') ///
>         (`chi') (`df') (`pp') (`mbar')
 62. end

