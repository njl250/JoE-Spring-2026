. putdocx table tbl(1, 3) = ("SE")

. putdocx table tbl(1, 4) = ("% Effect")

. putdocx table tbl(1, 5) = ("p-value")

. putdocx table tbl(1, 6) = ("Pre-Trend p-value")

. putdocx table tbl(1, 7) = ("Breakdown M-bar")

. putdocx table tbl(1, 8) = ("Treated States")

. putdocx table tbl(1, .), bold border(top, single)

. putdocx table tbl(1, .), border(bottom, single)

. putdocx table tbl(3, .), border(bottom, single)

. 
. putdocx paragraph

. putdocx text ("Notes: Outcome is ln(installed W per person + 1). Controls: ln 
> real GDP per capita and RPS status (doubly robust estimator); not-yet-treated 
> states as controls. "), ///
>     font("Times New Roman", 9)

. putdocx text ("ATT is the simple aggregation across cohorts and post-treatment
>  years; % effect = 100 x (exp(ATT) - 1). Standard errors clustered by state. "
> ), ///
>     font("Times New Roman", 9)

. putdocx text ("Pre-trend p-value: joint Wald test that event-time leads t = -6
>  to -2 equal zero (base t = -1). "), ///
>     font("Times New Roman", 9)

. putdocx text ("Breakdown M-bar: largest relative-magnitude violation of parall
> el trends (Rambachan & Roth, 2023) at which the 95% robust CI for the average 
> post-treatment effect excludes zero. "), ///
>     font("Times New Roman", 9)

. putdocx text ("* p<0.10, ** p<0.05, *** p<0.01."), font("Times New Roman", 9)

