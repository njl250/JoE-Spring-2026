. * ==============================================================================
. * 5. DOCUMENT 2: HONESTDID SENSITIVITIES & BOUNDS DOCUMENT (6 Tables)
. * ==============================================================================
. capture putdocx clear

. putdocx begin

. 
. putdocx paragraph, halign(center) spacing(after, 18pt)

. putdocx text ("HonestDiD Sensitivity & Robust Bounds Analysis"), bold font("Times N
> ew Roman", 16)

. 
. putdocx paragraph, halign(left) spacing(after, 12pt)

. putdocx text ("This companion diagnostic document presents individual, step-by-step
>  parallel trend violation sensitivity breakdowns for all six executions. The bounds
>  are calculated under the relative magnitudes framework (Rambachan and Roth, 2023) 
> across multiple threshold levels of trend divergence (M)."), font("Times New Roman"
> , 11)

. 
. capture program drop write_honest_table

. program define write_honest_table
  1.     args exec_num title_name outcome_name treatment_name m0_ci m05_ci m1_ci
  2. 
.     putdocx paragraph, spacing(before, 24pt) spacing(after, 6pt)
  3.     putdocx text ("Execution `exec_num': `title_name'"), bold font("Times New Ro
> man", 12)
  4.     
.     putdocx table t`exec_num' = (6, 3), halign(center)
  5.     putdocx table t`exec_num'(., 1), width(3.2 in)
  6.     putdocx table t`exec_num'(., 2), width(1.8 in)
  7.     putdocx table t`exec_num'(., 3), width(2.0 in)
  8.     
.     putdocx table t`exec_num'(.,.), border(all, nil)
  9.     putdocx table t`exec_num'(1,.), border(top, single, "000000", "1.5pt")
 10.     putdocx table t`exec_num'(1,.), border(bottom, single, "000000", "0.75pt")
 11.     putdocx table t`exec_num'(6,.), border(bottom, single, "000000", "1.5pt")
 12. 
.     putdocx table t`exec_num'(1,1) = ("HonestDiD Parameter")
 13.     putdocx table t`exec_num'(1,2) = ("Relative Shift Bound (M)")
 14.     putdocx table t`exec_num'(1,3) = ("95% Robust Confidence Interval")
 15.     forvalues col=1/3 {
 16.         putdocx table t`exec_num'(1,`col'), bold font("Times New Roman", 10)
 17.         if `col' > 1 putdocx table t`exec_num'(1,`col'), halign(center)
 18.     }
 19. 
.     putdocx table t`exec_num'(2,1) = ("Outcome Variable Profile")
 20.     putdocx table t`exec_num'(2,2) = ("`outcome_name'")
 21.     putdocx table t`exec_num'(2,3) = ("Policy: `treatment_name'")
 22.     
.     putdocx table t`exec_num'(3,1) = ("Exact Parallel Trends baseline")
 23.     putdocx table t`exec_num'(3,2) = ("M = 0.0")
 24.     putdocx table t`exec_num'(3,3) = ("`m0_ci'")
 25. 
.     putdocx table t`exec_num'(4,1) = ("Relative Trend shift allowance")
 26.     putdocx table t`exec_num'(4,2) = ("M = 0.5")
 27.     putdocx table t`exec_num'(4,3) = ("`m05_ci'")
 28. 
.     putdocx table t`exec_num'(5,1) = ("Relative Trend shift allowance")
 29.     putdocx table t`exec_num'(5,2) = ("M = 1.0")
 30.     putdocx table t`exec_num'(5,3) = ("`m1_ci'")
 31. 
.     putdocx table t`exec_num'(6,1) = ("State-Year Baseline Controls")
 32.     putdocx table t`exec_num'(6,2) = ("Yes")
 33.     putdocx table t`exec_num'(6,3) = ("ln(GDP pc), RPS, State & Year FE")
 34. 
.     forvalues row=2/6 {
 35.         forvalues col=1/3 {
 36.             putdocx table t`exec_num'(`row', `col'), font("Times New Roman", 10)
 37.             if `col' > 1 putdocx table t`exec_num'(`row', `col'), halign(center)
 38.         }
 39.     }
 40. 
.     putdocx paragraph, spacing(before, 4pt) spacing(after, 12pt)
 41.     putdocx text ("Note: "), bold italic font("Times New Roman", 9)
 42.     putdocx text ("Confidence intervals calculated under the Relative Magnitudes
>  framework (Delta_RM) in HonestDiD. For exact break-even values of M, please refere
> nce the generated diagram 'plot`exec_num'_honestdid_breakdown.png'."), italic font(
> "Times New Roman", 9)
 43.     
.     putdocx pagebreak
 44. end

