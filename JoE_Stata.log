. 
. * Systematically test windows from (-12 to -1) down to (-2 to -1)
. forvalues h = 12(-1)2 {
  2.     local varlist ""
  3.     forvalues i = `h'(-1)1 {
  4.         local varlist "`varlist' Tm`i'"
  5.     }
  6.     capture quietly test `varlist'
  7.     if !_rc {
  8.         post `loop_hold4a_rps' (`h') (r(p))
  9.     }
 10. }

. postclose `loop_hold4a_rps'

