. *=====================================================================
. * PART C: RESIDUAL DIAGNOSTICS & HETEROSKEDASTICITY CHECKS
. *=====================================================================
. 
. * Solar: RPS interaction model
. quietly regress ln_solar i.gb##i.is_rps real_gdp_per_capita i.state_id i.y
> ear

. estimates store m4_ols

. 
. * Solar: Corporate/Public interaction model
. quietly regress ln_solar i.gb##i.is_corporate i.gb##i.is_public is_rps ///
>     real_gdp_per_capita i.state_id i.year

. estimates store m8_ols

. 
. * Wind: RPS interaction model
. quietly regress ln_wind i.gb##i.is_rps real_gdp_per_capita i.state_id i.ye
> ar

. estimates store m12_ols

. 
. * Wind: Corporate/Public interaction model
. quietly regress ln_wind i.gb##i.is_corporate i.gb##i.is_public is_rps ///
>     real_gdp_per_capita i.state_id i.year

. estimates store m16_ols

. 
. foreach mod in m4_ols m8_ols m12_ols m16_ols {
  2. 
.     quietly estimates restore `mod'
  3.     predict resid_`mod' if e(sample), residuals
  4.     predict fitted_`mod' if e(sample), xb
  5. 
.     * Residuals vs fitted values
.     twoway scatter resid_`mod' fitted_`mod', ///
>         yline(0, lcolor(red)) ///
>         title("Residuals vs Fitted: `mod'") ///
>         ytitle("Residuals") xtitle("Fitted values") ///
>         name(rvf_`mod', replace)
  6.     graph export "rvf_`mod'.png", replace
  7. 
.     * Histogram of residuals
.     histogram resid_`mod', normal ///
>         title("Residual Distribution: `mod'") ///
>         name(hist_`mod', replace)
  8.     graph export "hist_`mod'.png", replace
  9. 
.     * Breusch-Pagan / Cook-Weisberg test
.     display as text "----- Breusch-Pagan/Cook-Weisberg test: `mod' -----"
 10.     estat hettest
 11. 
.     * White's test (may fail with many FE dummies - captured)
.     capture estat imtest, white
 12.     if _rc {
 13.         display as error "White's test could not be computed for `mod' 
> (likely too many parameters relative to N)."
 14.     }
 15. }
